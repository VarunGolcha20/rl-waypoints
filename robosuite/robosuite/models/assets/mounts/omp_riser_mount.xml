<mujoco model="omp_riser_mount">
    <!--
    Base plate under the OpenMANIPULATOR-P: a TurtleBot3 Waffle Pi waffle plate, ~9 mm thick (thickness to be
    confirmed by measurement), 14 x 14 cm footprint, lying on the table top.
    robosuite moves the mount root onto the robot base (top_offset = 0), so the box hangs *below* the root
    (geom pos z = -H/2). The root's pos z = -H in this file is read as bottom_offset, which is what lifts the robot by H
    above the surface it is placed on. To change the height H, edit all three together:
    root pos z = -H, geom size z = H/2, geom pos z = -H/2.
    The plate height matters: with the tool pointing straight down, J5's +-90 deg limit keeps the grip point at most
    ~0.10 m above the base, so H shifts the whole vertical working range (see IMPLEMENTATION_LOG.md, T3 / T3b).
    After changing H, rerun omp_tools/check_omp_workspace.py and update the task YAMLs' workspace blocks.
    -->
    <worldbody>
        <body name="base" pos="0 0 -0.009">
            <inertial pos="0 0 -0.0045" mass="0.2" diaginertia="0.0003 0.0003 0.0006"/>
            <geom name="riser_visual" type="box" size="0.07 0.07 0.0045" pos="0 0 -0.0045" rgba="0.25 0.25 0.28 1" contype="0" conaffinity="0" group="1"/>
            <geom name="riser_collision" type="box" size="0.07 0.07 0.0045" pos="0 0 -0.0045" group="0"/>
        </body>
    </worldbody>
</mujoco>
